generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                           String    @id @default(cuid())
  name                         String?
  email                        String?   @unique
  emailVerified                DateTime?
  image                        String?
  phoneNumber                  String?
  whatsappNotificationsEnabled Boolean   @default(true)
  password                     String?
  university                   String?
  role                         String    @default("RIDER") // RIDER, DRIVER, ADMIN

  dropsBalance              Int     @default(3)
  hasUsedFirstTopupDiscount Boolean @default(false)

  accounts      Account[]
  sessions      Session[]
  driverProfile DriverProfile?

  tripsAsRider  Trip[] @relation("RiderTrips")
  tripsAsDriver Trip[] @relation("DriverTrips")

  verificationCodes VerificationCode[]
  pushSubscriptions PushSubscription[]
  messages          Message[]

  referralCode   ReferralCode?
  referralsGiven Referral[]    @relation("ReferralsGiven")
  referredBy     Referral?     @relation("ReferredBy")

  dropTransactions DropTransaction[]
  dropLots         DropLot[]
  feedbacks        Feedback[]
  updateReads      UpdateRead[]
  privacyRequests  PrivacyRequest[]

  alarmLogs        AlarmLog[]
  tripReminders    TripReminder[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Tovedrop Models
model DriverProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone         String?
  area          String?
  bio           String?
  licenseNumber String?
  vehicleMake   String?
  vehicleModel  String?
  vehicleColor  String?
  vehicleType   String?
  vehiclePlate  String?

  availability   String?
  preferredAreas String?

  bankName      String?
  accountNumber String?
  accountName   String?

  status        String @default("PENDING") // PENDING, APPROVED, SUSPENDED
  totalTrips    Int    @default(0)
  rating        Float  @default(0.0)
  walletBalance Float  @default(0)

  walletTransactions WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]

  alarmEnabled        Boolean  @default(true)
  alarmTimes          Int[]    @default([30, 10, 2])
  alarmSound          String   @default("default")
  alarmVibrate        Boolean  @default(true)
}

model Trip {
  id             String  @id @default(cuid())
  status         String  @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  pickup         String
  pickupLat      Float?
  pickupLng      Float?
  destination    String
  destinationLat Float?
  destinationLng Float?
  date           String
  time           String
  notes          String?

  riderId String
  rider   User   @relation("RiderTrips", fields: [riderId], references: [id])

  driverId String?
  driver   User?   @relation("DriverTrips", fields: [driverId], references: [id])

  driverArrivedAt DateTime?

  isPool      Boolean @default(false)
  poolGroupId String?

  bookingFeeNaira Float?
  dropLotId       String?
  dropLot         DropLot? @relation(fields: [dropLotId], references: [id])

  review             Review?
  messages           Message[]
  walletTransactions WalletTransaction[]
  platformRevenue    PlatformRevenue?
  adminRevenue       AdminRevenue?
  shareToken         String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  alarmLogs          AlarmLog[]
  tripReminders      TripReminder[]
}

model Review {
  id        String   @id @default(cuid())
  tripId    String   @unique
  trip      Trip     @relation(fields: [tripId], references: [id])
  rating    Int
  note      String?
  createdAt DateTime @default(now())
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AdminLoginLog {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      String // Storing JSON as string since SQLite does not support Json type
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  tripId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
}

model ReferralCode {
  id     String @id @default(cuid())
  userId String @unique
  code   String @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referredId String   @unique
  status     String   @default("PENDING") // PENDING, COMPLETED
  createdAt  DateTime @default(now())

  referrer User @relation("ReferralsGiven", fields: [referrerId], references: [id])
  referred User @relation("ReferredBy", fields: [referredId], references: [id])
}

model DropTransaction {
  id          String   @id @default(cuid())
  userId      String
  type        String // PURCHASE, BOOKING, REFUND, GIFT
  amount      Int // positive = credit, negative = debit
  nairaAmount Float? // only set for PURCHASE type
  package     String?
  reference   String? // Paystack reference, PURCHASE only
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  dropLot DropLot?
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "ISSUE" or "SUGGESTION"
  content   String
  status    String   @default("OPEN") // "OPEN", "REVIEWED", "RESOLVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DropLot {
  id                String   @id @default(cuid())
  userId            String
  dropTransactionId String   @unique // the PURCHASE transaction that created this lot
  totalDrops        Int // how many drops this lot started with
  remainingDrops    Int // how many are left unspent
  pricePerDrop      Float // exact Naira value per drop in this lot
  createdAt         DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id])
  dropTransaction DropTransaction @relation(fields: [dropTransactionId], references: [id])
  trips           Trip[]
}

model WalletTransaction {
  id          String        @id @default(cuid())
  driverId    String
  tripId      String?
  type        String // RIDE_EARNING, ADJUSTMENT, WITHDRAWAL
  amount      Float // Naira, positive = credit
  description String
  createdAt   DateTime      @default(now())
  driver      DriverProfile @relation(fields: [driverId], references: [id])
  trip        Trip?         @relation(fields: [tripId], references: [id])
}

model WithdrawalRequest {
  id        String   @id @default(cuid())
  driverId  String
  amount    Float // Naira
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver DriverProfile @relation(fields: [driverId], references: [id])
}

model PlatformRevenue {
  id        String   @id @default(cuid())
  tripId    String   @unique
  amount    Float // Naira, TOVEDROP's cut for this ride
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id])
}

model AdminRevenue {
  id        String   @id @default(cuid())
  tripId    String   @unique
  amount    Float // Naira, Admin's cut for this ride
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id])
}

model SystemSettings {
  id                String   @id @default("default")
  driverPercentage  Int      @default(70)
  adminPercentage   Int      @default(10)
  companyPercentage Int      @default(20)
  updatedAt         DateTime @updatedAt
}

model Update {
  id          String         @id @default(cuid())
  title       String
  body        String // supports basic markdown-style formatting
  category    UpdateCategory
  audience    UpdateAudience @default(ALL)
  isPinned    Boolean        @default(false)
  publishedAt DateTime? // null = draft, not yet visible
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  updateReads UpdateRead[]
}

model UpdateRead {
  id       String   @id @default(cuid())
  userId   String
  updateId String
  readAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  update   Update   @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@unique([userId, updateId])
}

enum UpdateCategory {
  NEW_FEATURE
  IMPROVEMENT
  BUG_FIX
  ANNOUNCEMENT
  MAINTENANCE
}

enum UpdateAudience {
  ALL
  RIDERS
  DRIVERS
}

model PrivacyRequest {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  type      String   // "DOWNLOAD_DATA" or "DELETE_ACCOUNT"
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, REJECTED
  details   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AlarmLog {
  id            String    @id @default(cuid())
  tripId        String
  driverId      String
  minutesBefore Int
  firedAt       DateTime  @default(now())
  snoozedAt     DateTime?
  dismissed     Boolean   @default(false)
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver        User      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([tripId, minutesBefore])
}

model TripReminder {
  id        String   @id @default(cuid())
  tripId    String
  driverId  String
  remindAt  DateTime
  type      String
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver    User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
}
